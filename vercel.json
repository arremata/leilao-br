{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && VITE_DEPLOY_ENV=$VERCEL_ENV VITE_PREVIEW_WRITES=$ARREMATE_PREVIEW_ALLOW_WRITES npm run build",
  "outputDirectory": "frontend/dist",
  "services": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "vercel-backend/index.py",
      "routePrefix": "/api",
      "framework": "fastapi"
    }
  }
}
