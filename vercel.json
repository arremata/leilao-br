{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "VITE_DEPLOY_ENV=$VERCEL_ENV VITE_PREVIEW_WRITES=$ARREMATE_PREVIEW_ALLOW_WRITES npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "vercel-backend/",
      "framework": "fastapi",
      "entrypoint": "index:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
